{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Skill Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique slug for the skill"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "prompt",
        "script"
      ]
    },
    "invocation": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^/"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "required": [
        "command"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "version",
    "type",
    "invocation"
  ]
}
